# Copy to .env before running `docker compose up`.

# PostgreSQL password for the bundled database.
DB_PASSWORD=change-me-postgres

# HS256 signing key. Must be at least 32 bytes — the gateway refuses to start otherwise.
# Generate one with: openssl rand -base64 48
COPILOT_JWT_SECRET=replace-with-at-least-32-bytes-of-random

# Issuer expected in incoming tokens.
COPILOT_JWT_ISSUER=enterprise-copilot

# Comma-separated browser origins allowed to call the gateway.
COPILOT_CORS_ORIGINS=http://localhost:5173

# Applications permitted to use the gateway.
COPILOT_ALLOWED_APP_IDS=crm,demo

# Set to false and provide OPENAI_API_KEY to use a real model.
COPILOT_MOCK_LLM=true

# AI actions (tool calling / page operations). Off by default in production.
# Before enabling, configure copilot.tools.allowed and copilot.tools.required-permission
# (see docs/actions.md) — an empty allowlist offers every client-declared tool to the model.
COPILOT_TOOLS_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
