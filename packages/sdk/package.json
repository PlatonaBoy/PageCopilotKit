{
  "name": "@enterprise/copilot-sdk",
  "version": "1.0.0",
  "description": "Enterprise AI Copilot embeddable SDK — page-aware chat assistant for business web apps",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/enterprise-copilot.js"
  ],
  "main": "./dist/enterprise-copilot.esm.js",
  "module": "./dist/enterprise-copilot.esm.js",
  "browser": "./dist/enterprise-copilot.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/enterprise-copilot.esm.js",
      "default": "./dist/enterprise-copilot.esm.js"
    },
    "./iife": "./dist/enterprise-copilot.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run typecheck && vite build && npm run size",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0",
    "size": "node scripts/check-size.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.0.7"
  }
}
